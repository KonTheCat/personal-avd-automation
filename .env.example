# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ── Azure subscription ──────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
# Auth uses DefaultAzureCredential: locally this resolves to your `az login`
# session automatically. No client secret needed for this phase (Graph lookups
# are skipped — the username you pass in is trusted as-is).

# ── Resource group (host pool, VNet, and new VMs/NICs all live here) ────────
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus

# ── Existing AVD host pool (must already exist — this script never creates one) ─
AVD_HOST_POOL_NAME=

# ── Existing VNet/subnet new NICs attach to ─────────────────────────────────
# Leave AVD_VNET_RESOURCE_GROUP blank to use AZURE_RESOURCE_GROUP above. Set it
# explicitly if the VNet lives in a different RG (e.g. a shared/hub network).
AVD_VNET_RESOURCE_GROUP=
AVD_VNET_NAME=
AVD_SUBNET_NAME=

# ── Marketplace image for new session hosts ─────────────────────────────────
AVD_IMAGE_PUBLISHER=MicrosoftWindowsDesktop
AVD_IMAGE_OFFER=office-365
AVD_IMAGE_SKU=win11-24h2-avd-m365
AVD_IMAGE_VERSION=latest
# ^ "latest" works but floats — pin to an explicit version once you've run
#   `az vm image list --publisher MicrosoftWindowsDesktop --offer office-365
#   --sku win11-24h2-avd-m365 --all -o table` and picked one, so re-runs are
#   reproducible.

# ── VM sizing/disk defaults (override size per-run with `--vm-size`) ────────
AVD_VM_SIZE_DEFAULT=Standard_D4s_v5
AVD_OS_DISK_TYPE=Premium_LRS

# ── Local admin account ──────────────────────────────────────────────────────
# ARM requires a local admin account at VM-creation time even though real
# sign-in is via Entra ID join (AADLoginForWindows extension). This account is
# an unused break-glass fallback, not how anyone signs in day to day.
AVD_LOCAL_ADMIN_USERNAME=avdlocaladmin
AVD_LOCAL_ADMIN_PASSWORD=

# ── AVD agent installer sources ──────────────────────────────────────────────
# Required. These are NOT filled in with defaults on purpose: Microsoft
# rotates the fwlink redirect IDs for these installers periodically, and a
# stale hardcoded link here would fail silently months from now. Get the
# current "RDAgent" and "RDAgent BootLoader" download links from
# "Register session hosts to a host pool" on Microsoft Learn and paste them in.
AVD_AGENT_INSTALLER_URL=
AVD_BOOTLOADER_INSTALLER_URL=

# ── Naming ───────────────────────────────────────────────────────────────────
AVD_VM_NAME_PREFIX=avd-

# ── Provisioning polling ─────────────────────────────────────────────────────
# How long to wait for the new VM to appear as a registered session host
# before giving up (VM boot + extension run is typically several minutes).
AVD_REGISTRATION_TIMEOUT_SECONDS=900
AVD_REGISTRATION_POLL_INTERVAL_SECONDS=20

# ── Group-change trigger (Graph subscription) ───────────────────────────────
# Entra ID group whose membership drives provisioning.
AVD_USERS_GROUP=
# HTTP endpoint Graph change notifications are POSTed to. During the
# concept-proving phase this points at a Logic App standing in for the
# notification_listener Function (must echo back Graph's validationToken
# handshake — see avdprovisioning/graph_subscriptions.py). Leave unset once
# the real Function is deployed (see AVD_NOTIFICATION_LISTENER_URL below).
SAMPLE_HTTP_REQUEST_TARGET_FOR_GROUP_CHANGES=

# The deployed notification_listener Function's HTTP endpoint, e.g.
# https://<app>.azurewebsites.net/api/notifications. Used by
# `subscribe-group-changes` and by subscription_renewer's recreate path.
AVD_NOTIFICATION_LISTENER_URL=

# ── State storage (Blob) ─────────────────────────────────────────────────────
# Blob Storage account holding subscription.json + hostmap/*.json — see
# avdprovisioning/state.py. The identity running this (your az login locally,
# the Function App's managed identity in production) needs the "Storage Blob
# Data Contributor" role on this account.
AVD_STATE_STORAGE_ACCOUNT_URL=
AVD_STATE_CONTAINER_NAME=state

# ── Registration-token cache (Key Vault) ────────────────────────────────────
# Key Vault holding the cached AVD host pool registration token as a secret
# ("registration-token") — see avdprovisioning/token_vault.py. Locking around
# the mint-if-needed decision still uses the blob lease above
# (AVD_STATE_STORAGE_ACCOUNT_URL); both must be set for caching to be used, or
# every provisioning call mints a fresh token unconditionally (racy, see
# provisioning.py's _get_registration_info). The identity running this (your
# az login locally, the Function App's managed identity in production) needs
# the "Key Vault Secrets Officer" role on this vault — not "Key Vault Secrets
# User", which is read-only and can't save a newly minted token.
AVD_KEYVAULT_URL=
